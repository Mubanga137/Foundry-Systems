# FS-CAE Environment Configuration
# Copy this file to .env and fill in your values.

# Database
DATABASE_URL=sqlite:///./foundry_cae.db

# Timezone
TIMEZONE=Africa/Lusaka

# Environment: development | testing | production
ENVIRONMENT=development

# Legal Entity
FOUNDRY_LEGAL_NAME=Foundry Systems (Elysium Group Limited)

# Banking Details (required in production)
FOUNDRY_BANK_NAME=
FOUNDRY_ACCOUNT_NUMBER=
FOUNDRY_BRANCH_CODE=

# Multi-Key Google Gemini Configuration
# Supports comma-separated in GEMINI_API_KEYS or individual GEMINI_API_KEY_1 / 2 / 3
GEMINI_API_KEYS="PASTE_KEY_1_HERE,PASTE_KEY_2_HERE,PASTE_KEY_3_HERE"
# GEMINI_API_KEY_1=""
# GEMINI_API_KEY_2=""
# GEMINI_API_KEY_3=""
GEMINI_MODEL="gemini-1.5-flash"
